# Copy to .env (git-ignored) or export. Never commit real values.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5203
# Shared password for the invented demo users (Development only). Empty: one is generated and logged once.
Demo__Password=
# Seed invented data outside Development (demos only).
Demo__Seed=false
# Where documents are stored: <root>/<tenantId>/<documentId>.pdf
Documents__Root=App_Data/documents
Documents__MaxBytes=10485760
