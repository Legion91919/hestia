@page "/login"
@attribute [AllowAnonymous]
@inject SessionService Sessions
@inject NavigationManager Nav
<PageTitle>Sign in · Hestia</PageTitle>

<section class="card narrow">
    <h1>Sign in</h1>
    <p class="meta">Your quarterly statements and notices from Harbourline, in one place.</p>
    @if (_error is not null)
    {
        <div class="banner banner-error" role="alert">@_error</div>
    }
    <EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" method="post">
        <DataAnnotationsValidator />
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="Input.Email" autocomplete="username" type="email" required />
        <label for="password">Password</label>
        <InputText id="password" @bind-Value="Input.Password" autocomplete="current-password" type="password" required />
        <button type="submit" class="btn">Sign in</button>
    </EditForm>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? _error;

    private async Task SignInAsync()
    {
        var result = await Sessions.SignInAsync(Input.Email ?? string.Empty, Input.Password ?? string.Empty);
        if (result.IsFailure)
        {
            _error = result.Error.Code switch
            {
                "auth.access_revoked" => "Your access has been withdrawn. Please contact investor relations.",
                "auth.locked_out" => "Too many attempts. Try again in 15 minutes.",
                _ => "That email and password do not match.",
            };
            return;
        }

        Security.SessionCookie.Write(HttpContext, result.Value.Token, result.Value.Lifetime);
        Nav.NavigateTo(SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    internal static string SafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal) && !url.StartsWith("/\\", StringComparison.Ordinal) ? url : "/";

    private sealed class LoginInput
    {
        [System.ComponentModel.DataAnnotations.Required] public string? Email { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string? Password { get; set; }
    }
}
