<li class="row">
    <div class="row-text">
        <b>@Row.Title</b>
        <div class="meta num">@Row.KindLabel &middot; @Row.Period &middot; @Row.PublishedLabel &middot; @Row.SizeLabel</div>
    </div>
    <span class="@(Row.IsNew ? "tag tag-new" : "tag tag-quiet")">@Row.StatusLabel</span>
    <a class="row-link" href="@Row.DownloadUrl" data-enhance-nav="false" aria-label="Open @Row.Title, @Row.Period">Open</a>
</li>

@code {
    [Parameter, EditorRequired] public DocumentRowModel Row { get; set; } = default!;
}
