<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <!-- Tests favour readability; underscores in test names are intentional. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2000;CA1062;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Agentic.Blocks.Testing" Version="0.1.0" />
    <ProjectReference Include="../../src/Hestia.Api/Hestia.Api.csproj" />
  </ItemGroup>
</Project>
